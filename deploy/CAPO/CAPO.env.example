# Copy to /etc/omertaos/omertaos.env on the Linux target.
# Replace every CHANGE_ME value outside Git and restrict the file to the service account.

OMERTAOS_USER=omertaos
OMERTAOS_GROUP=omertaos
OMERTAOS_ROOT=/opt/omertaos/current
OMERTAOS_STATE_DIR=/var/lib/omertaos

CONSOLE_HOST=0.0.0.0
CONSOLE_PORT=3000
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080

GATEWAY_HOST=0.0.0.0
OMERTA_GATEWAY_PORT=8080
OMERTA_CONTROL_BASE_URL=http://127.0.0.1:8000
OMERTA_CONTROL_GRPC=127.0.0.1:50051

CONTROL_HOST=127.0.0.1
OMERTA_CONTROL_HTTP_PORT=8000
CONTROL_POSTGRES_DSN=postgresql://omertaos:CHANGE_ME@127.0.0.1:5432/omertaos
CONTROL_REDIS_URL=redis://127.0.0.1:6379/0
CAPO_POSTGRES_ROLE=omertaos
CAPO_POSTGRES_DATABASE=omertaos
CAPO_POSTGRES_PASSWORD=CHANGE_ME
CONTROL_MODELS_DIRECTORY=/opt/omertaos/current/registry/models
CONTROL_POLICIES_DIRECTORY=/opt/omertaos/current/policies

OMERTA_RUNTIME_BIND_ADDR=127.0.0.1:50051
OMERTA_RUNTIME_ENDPOINT=127.0.0.1:50051

# Optional services default off. Enabling one requires a reachable endpoint and
# externally supplied credentials. Disabled capabilities must fail explicitly.
CAPO_MONGO_ENABLED=false
CONTROL_MONGO_DSN=mongodb://127.0.0.1:27017/omertaos
CAPO_QDRANT_ENABLED=false
CONTROL_QDRANT_URL=http://127.0.0.1:6333
CAPO_MINIO_ENABLED=false
CONTROL_MINIO_ENDPOINT=http://127.0.0.1:9000
CONTROL_MINIO_ACCESS_KEY=CHANGE_ME
CONTROL_MINIO_SECRET_KEY=CHANGE_ME
CONTROL_MINIO_BUCKET=omertaos-raw
