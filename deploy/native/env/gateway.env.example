# Install as /etc/omertaos/gateway.env (0640 root:omertaos).
OMERTA_GATEWAY_HOST=0.0.0.0
OMERTA_GATEWAY_PORT=8080
# Only enable when requests arrive through a configured trusted reverse proxy.
OMERTA_TRUST_PROXY=false
OMERTA_CONTROL_BASE_URL=http://127.0.0.1:8000
# gRPC endpoints are host:port values; do not add an http:// scheme.
OMERTA_CONTROL_GRPC=127.0.0.1:50051
OMERTA_REDIS_URL=redis://127.0.0.1:6379/1
OMERTA_CONSOLE_ORIGIN=http://127.0.0.1:3000
OMERTA_GATEWAY_PROFILE=user
OMERTA_ENV=production
OMERTA_GATEWAY_ADMIN_TOKEN=CHANGE_ME
SECRET_PROVIDER_MODE=local
