{
  "version": 2,
  "supported_platforms": ["Debian 12", "Ubuntu 22.04 LTS", "Ubuntu 24.04 LTS"],
  "templates": {
    "omertaos.env.example": {
      "mode": "0644",
      "owner": "root:root",
      "required": ["OMERTAOS_ENV_CONTRACT_VERSION", "OMERTAOS_USER", "OMERTAOS_GROUP", "OMERTAOS_ROOT", "OMERTAOS_CONFIG_DIR", "OMERTAOS_STATE_DIR", "OMERTAOS_LOG_DIR", "OMERTAOS_BACKUP_DIR"]
    },
    "runtime.env.example": {
      "mode": "0640",
      "owner": "root:omertaos",
      "required": ["OMERTA_RUNTIME_BIND_ADDR", "OMERTA_RUNTIME_HEALTH_ADDR", "OMERTA_PROFILE"]
    },
    "control.env.example": {
      "mode": "0640",
      "owner": "root:omertaos",
      "required": ["CONTROL_HOST", "OMERTA_CONTROL_HTTP_PORT", "OMERTA_RUNTIME_ENDPOINT", "OMERTA_CONTROL_POSTGRES_DSN", "OMERTA_CONTROL_REDIS_URL", "OMERTA_CONTROL_MODELS_DIRECTORY", "OMERTA_CONTROL_POLICIES_DIRECTORY", "OMERTA_CONTROL_DATA_DIR", "OMERTA_CONTROL_SECRET_DIR", "OMERTA_CONTROL_LOCAL_SECRET_KEY", "OMERTA_GATEWAY_ADMIN_TOKEN"]
    },
    "gateway.env.example": {
      "mode": "0640",
      "owner": "root:omertaos",
      "required": ["OMERTA_GATEWAY_HOST", "OMERTA_GATEWAY_PORT", "OMERTA_CONTROL_BASE_URL", "OMERTA_CONTROL_GRPC", "OMERTA_REDIS_URL", "OMERTA_CONSOLE_ORIGIN", "OMERTA_GATEWAY_PROFILE", "OMERTA_GATEWAY_ADMIN_TOKEN"]
    },
    "console.env.example": {
      "mode": "0640",
      "owner": "root:omertaos",
      "required": ["HOSTNAME", "PORT", "NEXT_PUBLIC_GATEWAY_URL", "GATEWAY_URL", "NEXTAUTH_URL", "NEXTAUTH_SECRET", "OMERTA_GATEWAY_ADMIN_TOKEN", "SECRET_PROVIDER_MODE", "DATABASE_URL", "OMERTA_ENABLE_PRISMA"],
      "forbidden_prefixes": ["AION_CONTROL_", "AION_RUNTIME_", "OMERTA_CONTROL_", "OMERTA_RUNTIME_", "CONTROL_"]
    },
    "installer.env.example": {
      "mode": "0600",
      "owner": "root:root",
      "required": ["OMERTAOS_POSTGRES_ROLE", "OMERTAOS_POSTGRES_DATABASE", "OMERTAOS_POSTGRES_PASSWORD", "OMERTAOS_CONSOLE_POSTGRES_ROLE", "OMERTAOS_CONSOLE_POSTGRES_DATABASE", "OMERTAOS_CONSOLE_POSTGRES_PASSWORD", "OMERTAOS_CONSOLE_ADMIN_EMAIL", "OMERTAOS_CONSOLE_ADMIN_PASSWORD", "OMERTAOS_CONSOLE_ADMIN_NAME"]
    }
  },
  "secret_keys": ["OMERTA_GATEWAY_ADMIN_TOKEN", "NEXTAUTH_SECRET", "OMERTA_CONTROL_LOCAL_SECRET_KEY", "OMERTAOS_POSTGRES_PASSWORD", "OMERTAOS_CONSOLE_POSTGRES_PASSWORD", "OMERTAOS_CONSOLE_ADMIN_EMAIL", "OMERTAOS_CONSOLE_ADMIN_PASSWORD"],
  "credential_url_keys": ["OMERTA_CONTROL_POSTGRES_DSN", "DATABASE_URL"],
  "loopback_keys": ["CONTROL_HOST", "OMERTA_RUNTIME_BIND_ADDR", "OMERTA_RUNTIME_HEALTH_ADDR", "OMERTA_RUNTIME_ENDPOINT"],
  "port_keys": ["OMERTA_CONTROL_HTTP_PORT", "OMERTA_GATEWAY_PORT", "PORT"],
  "deprecated_aliases": {
    "AION_ADMIN_TOKEN": "OMERTA_GATEWAY_ADMIN_TOKEN",
    "AION_CONTROL_CORS_ORIGINS": "OMERTA_CONTROL_CORS_ORIGINS",
    "AION_CONTROL_DATA_DIR": "OMERTA_CONTROL_DATA_DIR",
    "AION_CONTROL_HTTP_PORT": "OMERTA_CONTROL_HTTP_PORT",
    "AION_CONTROL_LOCAL_SECRET_KEY": "OMERTA_CONTROL_LOCAL_SECRET_KEY",
    "AION_CONTROL_MODELS_DIRECTORY": "OMERTA_CONTROL_MODELS_DIRECTORY",
    "AION_CONTROL_POLICIES_DIRECTORY": "OMERTA_CONTROL_POLICIES_DIRECTORY",
    "AION_CONTROL_POSTGRES_DSN": "OMERTA_CONTROL_POSTGRES_DSN",
    "AION_CONTROL_REDIS_URL": "OMERTA_CONTROL_REDIS_URL",
    "AION_CONTROL_SECRET_DIR": "OMERTA_CONTROL_SECRET_DIR",
    "AION_CONTROL_BASE_URL": "OMERTA_CONTROL_BASE_URL",
    "AION_CONTROL_GRPC": "OMERTA_CONTROL_GRPC",
    "AION_CONSOLE_ORIGIN": "OMERTA_CONSOLE_ORIGIN",
    "AION_ENABLE_PRISMA": "OMERTA_ENABLE_PRISMA",
    "AION_ENV": "OMERTA_ENV",
    "AION_GATEWAY_ADMIN_TOKEN": "OMERTA_GATEWAY_ADMIN_TOKEN",
    "AION_GATEWAY_HOST": "OMERTA_GATEWAY_HOST",
    "AION_GATEWAY_PORT": "OMERTA_GATEWAY_PORT",
    "AION_PROFILE": "OMERTA_GATEWAY_PROFILE",
    "AION_REDIS_URL": "OMERTA_REDIS_URL",
    "AION_RUNTIME_BIND_ADDR": "OMERTA_RUNTIME_BIND_ADDR",
    "AION_RUNTIME_ENDPOINT": "OMERTA_RUNTIME_ENDPOINT",
    "AION_RUNTIME_HEALTH_ADDR": "OMERTA_RUNTIME_HEALTH_ADDR",
    "AION_TRUST_PROXY": "OMERTA_TRUST_PROXY"
  },
  "profiles": ["lite", "full", "enterprise"],
  "gateway_profiles": {
    "lite": "user",
    "full": "professional",
    "enterprise": "enterprise-vip"
  }
}
