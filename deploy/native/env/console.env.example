# Install as /etc/omertaos/console.env (0640 root:omertaos).
HOSTNAME=0.0.0.0
PORT=3000
NEXT_PUBLIC_GATEWAY_URL=http://127.0.0.1:8080
GATEWAY_URL=http://127.0.0.1:8080
NEXTAUTH_URL=http://127.0.0.1:3000
NEXTAUTH_SECRET=CHANGE_ME
OMERTA_GATEWAY_ADMIN_TOKEN=CHANGE_ME
SECRET_PROVIDER_MODE=local
# Temporary native auth-store requirement. It is not a Control/Runtime endpoint.
DATABASE_URL=postgresql://omertaos_console:CHANGE_ME@127.0.0.1:5432/omertaos_console
OMERTA_ENABLE_PRISMA=1
