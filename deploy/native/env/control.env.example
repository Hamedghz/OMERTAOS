# Install as /etc/omertaos/control.env (0640 root:omertaos).
CONTROL_HOST=127.0.0.1
OMERTA_CONTROL_HTTP_PORT=8000
OMERTA_RUNTIME_ENDPOINT=127.0.0.1:50051
OMERTA_CONTROL_POSTGRES_DSN=postgresql://omertaos:CHANGE_ME@127.0.0.1:5432/omertaos
OMERTA_CONTROL_REDIS_URL=redis://127.0.0.1:6379/0
OMERTA_CONTROL_MODELS_DIRECTORY=/opt/omertaos/current/registry/models
OMERTA_CONTROL_POLICIES_DIRECTORY=/opt/omertaos/current/policies
OMERTA_CONTROL_DATA_DIR=/var/lib/omertaos/control
OMERTA_CONTROL_SECRET_DIR=/etc/omertaos/secrets/control
OMERTA_CONTROL_LOCAL_SECRET_KEY=CHANGE_ME
OMERTA_CONTROL_CORS_ORIGINS=http://127.0.0.1:3000
OMERTA_GATEWAY_ADMIN_TOKEN=CHANGE_ME
