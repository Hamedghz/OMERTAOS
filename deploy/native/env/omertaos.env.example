# Native common environment: install as /etc/omertaos/omertaos.env (0644 root:root).
# This file is intentionally non-secret. Service credentials belong in the
# service-specific 0640 files beside it.

OMERTAOS_ENV_CONTRACT_VERSION=2
OMERTAOS_ENV=production
OMERTAOS_USER=omertaos
OMERTAOS_GROUP=omertaos
OMERTAOS_ROOT=/opt/omertaos/current
OMERTAOS_CONFIG_DIR=/etc/omertaos
OMERTAOS_STATE_DIR=/var/lib/omertaos
OMERTAOS_LOG_DIR=/var/log/omertaos
OMERTAOS_BACKUP_DIR=/var/lib/omertaos/backups
