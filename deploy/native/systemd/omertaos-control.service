[Unit]
Description=OMERTAOS Control plane
Requires=omertaos-runtime.service postgresql.service redis-server.service
After=network-online.target omertaos-runtime.service postgresql.service redis-server.service
Wants=network-online.target
PartOf=omertaos.target
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=simple
User=omertaos
Group=omertaos
EnvironmentFile=/etc/omertaos/omertaos.env
EnvironmentFile=/etc/omertaos/control.env
WorkingDirectory=/opt/omertaos/current
ExecStart=/opt/omertaos/current/.venv/control/bin/python -m control.app.serve
ExecStartPre=/usr/bin/test -x /opt/omertaos/current/.venv/control/bin/python
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/omertaos/control /etc/omertaos/secrets/control
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0027

[Install]
WantedBy=omertaos.target
