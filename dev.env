# Development defaults for quickstart. Replace placeholder secrets before production use.
# OMERTA_* names are canonical. Legacy AION_* input remains accepted by the
# migration preflight and component resolvers, but active templates publish one name.
OMERTA_ENV=dev
OMERTA_GATEWAY_PROFILE=user
CONTROL_URL=http://control:8000
GATEWAY_URL=http://gateway:8080
OMERTA_GATEWAY_URL=http://gateway:8080
CONSOLE_URL=http://localhost:3000
CONSOLE_PORT=3000

# Database
OMERTA_DB_USER=aion
OMERTA_DB_PASSWORD=password
OMERTA_DB_NAME=omerta_db
OMERTA_CONTROL_POSTGRES_DSN=postgresql://aion:password@postgres:5432/omerta_db
DATABASE_URL=postgresql://aion:password@postgres:5432/omerta_db?schema=public
OMERTA_ENABLE_PRISMA=1
OMERTA_CONTROL_MONGO_DSN=mongodb://mongo:27017/aion?retryWrites=true&w=majority

# Caches and vector stores
OMERTA_CONTROL_REDIS_URL=redis://redis:6379/0
OMERTA_CONTROL_QDRANT_URL=http://qdrant:6333

# Object storage
OMERTA_CONTROL_MINIO_ENDPOINT=minio:9000
OMERTA_CONTROL_MINIO_ACCESS_KEY=minio
OMERTA_CONTROL_MINIO_SECRET_KEY=miniosecret
OMERTA_CONTROL_MINIO_BUCKET=aion-raw
OMERTA_CONTROL_MINIO_SECURE=0

# Paths
OMERTA_CONTROL_MODELS_DIRECTORY=/srv/app/registry/models
OMERTA_CONTROL_POLICIES_DIRECTORY=/srv/app/policies
OMERTA_AGENT_CATALOG_DIR=/srv/app/agent_catalog
FEATURE_LATENTBOX_RECOMMENDATIONS=1
TENANCY_MODE=single
OMERTA_CONTROL_DISABLE_SECRETS=1
OMERTA_CONTROL_LOCAL_SECRET_KEY=

# Gateway / auth
OMERTA_GATEWAY_API_KEYS=demo-key:admin
OMERTA_GATEWAY_API_KEYS_SECRET_PATH=
OMERTA_GATEWAY_ADMIN_TOKEN=demo-admin-token
OMERTA_GATEWAY_ADMIN_TOKEN_SECRET_PATH=
OMERTA_JWT_SECRET_PATH=
OMERTA_JWT_PUBLIC_KEY=
NEXTAUTH_SECRET=dev-secret-change-me
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080
OMERTA_GATEWAY_PORT=8080
OMERTA_GATEWAY_HOST=0.0.0.0
OMERTA_REDIS_URL=redis://redis:6379/0
CONTROL_BASE_URL=http://localhost:8000
GATEWAY_BASE_URL=http://localhost:8080
CONSOLE_BASE_URL=http://localhost:3000
OMERTA_CONTROL_BASE_URL=http://control:8000
OMERTA_CONTROL_API_PREFIX=/api
VAULT_ADDR=http://vault:8200
VAULT_KV_MOUNT=secret
VAULT_TOKEN=
SECRET_PROVIDER_MODE=local
CONSOLE_ADMIN_EMAIL=admin@local
CONSOLE_ADMIN_PASSWORD=DevOnly-Admin-2026-ChangeMe
SKIP_CONSOLE_SEED=false

# TLS and telemetry
OMERTA_TLS_REQUIRED=false
OMERTA_TLS_REQUIRE_MTLS=false
OMERTA_TELEMETRY_OPT_IN=false
OMERTA_TELEMETRY_ENDPOINT=http://localhost:4317
